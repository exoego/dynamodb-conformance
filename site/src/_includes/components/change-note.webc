<details webc:if="entry" data-dismiss data-change-note class="relative inline-block text-left align-middle">
  <summary
    :class="'list-none [&::-webkit-details-marker]:hidden cursor-pointer inline-flex items-center gap-1.5 rounded text-zinc-500 dark:text-zinc-400 hover:text-brand-600 dark:hover:text-brand-300 ' + (label ? 'text-xs font-medium' : '')"
    :aria-label="label ? false : ('What changed in the suite on ' + entry.dateLabel)">
    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
    </svg>
    <span webc:if="label" @text="label"></span>
  </summary>
  <div class="absolute left-0 z-30 mt-2 w-72 max-w-[80vw] rounded-lg border border-zinc-200 dark:border-white/10 bg-white dark:bg-surface-900 shadow-lg p-4 font-normal normal-case tracking-normal">
    <p class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Suite on <time :datetime="entry.date" @text="entry.dateLabel"></time></p>
    <div class="prose prose-sm prose-zinc dark:prose-invert max-w-none text-zinc-600 dark:text-zinc-300 prose-p:my-0" @html="entry.bodyHtml"></div>
  </div>
</details>
